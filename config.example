# AlertView configuration
# All fields are optional except for sources

# Server configuration
port: 8080
refresh_interval: 30   # seconds between each auto-refresh

# Global timeout for all sources (can be overridden per source)
tls_insecure: false    # true to ignore TLS certificate errors (self-signed certs)

# Cache configuration (0 = disabled)
cache_ttl_seconds: 0

# Logging configuration
log_format: "text"  # or "json" for structured logs
# Can also be set via ALERTVIEW_LOG_FORMAT environment variable

# Config auto-reload configuration
config_watch_method: "polling"  # "inotify" (native) or "polling" (default, works everywhere)
config_poll_interval: 10        # Polling interval in seconds (only used with polling method)
# Can also be set via ALERTVIEW_CONFIG_WATCH_METHOD and ALERTVIEW_CONFIG_POLL_INTERVAL

sources:
  - name: "Alertmanager"
    type: alertmanager
    url: "http://alertmanager.example.com:9093"
    dashboard_url: "https://grafana.example.com/alerting/list"
    timeout: 15  # seconds (default: 15)
    # Label used to classify severity (case-insensitive, default: "severity").
    # Set this if your alerts carry the level under a different label name.
    # severity_label: "Severity"
    # link_template: "https://grafana.example.com/alerts?query={{.Labels.alertname}}"
    # Per-source overrides of the display settings above:
    # alert_link_template: "https://wiki.example.com/runbook/{{.Labels.alertname}}"
    # source_link: false   # no arrow for this source
    # basic_auth:
    #   username: admin
    #   password: secret
    # bearer_token: "YOUR_TOKEN_HERE"
    # retry_policy:
    #   max_retries: 3
    #   initial_delay_ms: 1000
    #   max_delay_ms: 30000

  - name: "Grafana"
    type: grafana
    url: "http://grafana.example.com:3000"
    dashboard_url: "https://grafana.example.com/"
    timeout: 15
    # bearer_token is Grafana Service Account token (recommended)
    # bearer_token: "YOUR_GRAFANA_TOKEN_HERE"
    # or basic_auth with admin account:
    # basic_auth:
    #   username: admin
    #   password: secret
    # link_template: "https://grafana.example.com/d/{{.Annotations.dashboardUid}}?viewPanel={{.Annotations.panelId}}"

  - name: "Zabbix"
    type: zabbix
    url: "https://zabbix.example.com/zabbix"
    dashboard_url: "https://zabbix.example.com/zabbix/zabbix.php?action=problem.view"
    timeout: 15
    # Zabbix API token
    # bearer_token: "YOUR_ZABBIX_TOKEN_HERE"
    # link_template: "https://zabbix.example.com/zabbix/zabbix.php?action=problem.view&filter_eventid={{.Labels.eventid}}"

display:
  # Labels to show on each alert card (severity and alertname are always shown as badges)
  labels:
    - namespace
    - job
    - instance
    - cluster
    - node
    - pod
    - host
    - hostgroup
  
  # Theme: "auto" (follows the OS light/dark setting, default), "dark" or "light".
  # A user who clicks the theme button in the UI overrides this in their browser.
  # theme: "auto"
  # Extra stylesheet layered on top of the theme
  # custom_css: "https://example.com/alertview-theme.css"
  
  # Timezone: "local", "UTC", or any IANA timezone (e.g., "Europe/Paris", "America/New_York")
  # timezone: "local"
  
  # Enable sound notifications for new alerts
  # play_sounds: false
  
  # Group alerts by labels (e.g., ["namespace", "job"])
  # group_by: ["namespace"]

  # Labels shown in front of the alert name, in both normal and TV mode.
  # Only the ones the alert carries are shown, joined by prefix_separator, and
  # they are dropped from the label chips so nothing appears twice.
  # Shown even if they are not listed in display.labels above.
  # prefix_labels: ["hostname"]
  # prefix_separator: " / "

  # Start in TV mode. Only applies to a browser where nobody has used the TV
  # button yet; "?tv=1" in the URL always wins (use it for a kiosk display).
  # tv_mode_default: false

  # Make the whole alert clickable, with a link built from its labels.
  # Placeholders: {{.Labels.x}}, {{.Annotations.x}}, {{.Name}}, {{.Severity}},
  # {{.Status}}, {{.Source}}, {{.SourceType}}, {{.StartsAt}}, {{.EndsAt}}.
  # An alert missing one of the labels used here simply is not clickable.
  # Can be overridden per source with alert_link_template.
  # alert_link_template: "https://wiki.example.com/runbook/{{.Labels.alertname}}?host={{.Labels.hostname}}"

  # Show the alert name (the alertname label). false = show the summary
  # annotation instead; alerts without a summary keep their name.
  # show_alert_name: true

  # Show the label chips next to each alert (the "key=value" pills).
  # show_labels: true

  # Icon marking critical alerts, "" to disable
  # critical_icon: "🔥"

  # Show the "open in the source" arrow on the right of each alert.
  # Its destination is independent from alert_link_template above.
  # source_link: true

  # Open links in a new tab (false keeps them in the same tab, for kiosks)
  # link_new_tab: true

  # Severity levels, most severe first. Alerts are sorted in this order and the
  # filter chips follow it. A severity that is not listed sorts last.
  # Aliases are matched too: crit/err/warn/information.
  # severity_order: ["critical", "error", "high", "warning", "info", "none"]

# Environment variables that can be used instead of config file:
# ALERTVIEW_PORT=8080
# ALERTVIEW_REFRESH_INTERVAL=30
# ALERTVIEW_CACHE_TTL=60
# ALERTVIEW_LOG_FORMAT=json
